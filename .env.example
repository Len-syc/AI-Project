# ===== LLM 配置 =====
# mock = 纯本地规则，无外部依赖，完整跑通演示链路（默认）
# api  = 走真实 LLM（OpenAI 兼容协议）
LLM_MODE=mock

# ===== 工具调用方式 =====
# direct = 进程内直调（默认）
# mcp    = Agent 作为 MCP host，经 stdio 协议调用 app/mcp_servers/ 下的 3 个工具服务
TOOL_MODE=direct

# 主模型（DeepSeek 示例，换厂商改这三行即可）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat
LLM_SMALL_MODEL=deepseek-chat

# 视觉模型（材料识别；智谱 GLM-4V-Flash 免费）
VLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VLM_API_KEY=xxxx
VLM_MODEL=glm-4v-flash
