{
  "domain_id": "suzhou_residence",
  "name": "居住证办理（苏州）",
  "description": "流动人口居住登记、居住证申领与签注等事项",
  "intent_keywords": [
    "居住证",
    "暂住证",
    "居住登记",
    "流动人口",
    "租房备案"
  ],
  "profile_fields": [
    {
      "name": "城市",
      "type": "enum",
      "options": [
        "苏州",
        "南京",
        "上海",
        "杭州"
      ],
      "question": "你在哪个城市居住？（当前演示知识库覆盖苏州）",
      "extract": {
        "any_of": {
          "苏州": "苏州",
          "南京": "南京",
          "上海": "上海",
          "杭州": "杭州"
        }
      },
      "required": true
    },
    {
      "name": "居住事由",
      "type": "enum",
      "options": [
        "合法稳定就业",
        "合法稳定住所",
        "连续就读"
      ],
      "question": "你在苏州的居住事由是：工作就业、租房（有稳定住所），还是上学就读？",
      "extract": {
        "any_of": {
          "工作": "合法稳定就业",
          "上班": "合法稳定就业",
          "就业": "合法稳定就业",
          "租房": "合法稳定住所",
          "买房": "合法稳定住所",
          "住所": "合法稳定住所",
          "上学": "连续就读",
          "读书": "连续就读",
          "就读": "连续就读"
        }
      },
      "required": true
    },
    {
      "name": "居住登记月数",
      "type": "int",
      "question": "你来苏州居住登记满几个月了？（不满半年也可以先说实际情况）",
      "extract": {
        "regex_int": {
          "pattern": "(\\d{1,3})\\s*个?月",
          "min": 0,
          "max": 600
        }
      },
      "required": true
    },
    {
      "name": "已有居住凭证",
      "type": "bool",
      "question": "你是否已经办理过居住登记凭证或持有过期居住证？",
      "extract": {
        "bool": {
          "true_any": [
            "登记过",
            "办过凭证",
            "有凭证",
            "过期居住证",
            "以前办过"
          ],
          "false_any": [
            "没登记",
            "没办过",
            "没有凭证",
            "第一次办"
          ]
        }
      },
      "required": false
    }
  ]
}