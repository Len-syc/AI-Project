{
  "domain_id": "suzhou_startup",
  "name": "高校毕业生就业创业（苏州）",
  "description": "毕业生求职创业补贴、人才落户、租房补贴、创业贷款等事项",
  "intent_keywords": [
    "创业",
    "开公司",
    "开店",
    "就业",
    "毕业",
    "应届",
    "落户",
    "人才",
    "求职",
    "灵活就业"
  ],
  "profile_fields": [
    {
      "name": "城市",
      "type": "enum",
      "options": [
        "苏州",
        "南京",
        "上海",
        "杭州",
        "北京",
        "深圳",
        "广州",
        "成都",
        "武汉",
        "西安",
        "郑州",
        "合肥",
        "无锡",
        "常州",
        "南通",
        "徐州",
        "福州",
        "厦门",
        "长沙",
        "重庆"
      ],
      "question": "你准备在哪个城市办理这件事？（当前演示知识库覆盖苏州）",
      "extract": {
        "any_of": {
          "苏州": "苏州",
          "南京": "南京",
          "上海": "上海",
          "杭州": "杭州",
          "北京": "北京",
          "深圳": "深圳",
          "广州": "广州",
          "成都": "成都",
          "武汉": "武汉",
          "西安": "西安",
          "郑州": "郑州",
          "合肥": "合肥",
          "无锡": "无锡",
          "常州": "常州",
          "南通": "南通",
          "徐州": "徐州",
          "福州": "福州",
          "厦门": "厦门",
          "长沙": "长沙",
          "重庆": "重庆"
        }
      },
      "required": true
    },
    {
      "name": "学历",
      "type": "enum",
      "options": [
        "大专",
        "本科",
        "硕士",
        "博士"
      ],
      "question": "你的学历是？（大专 / 本科 / 硕士 / 博士）",
      "extract": {
        "any_of": {
          "博士": "博士",
          "硕士": "硕士",
          "研究生": "硕士",
          "本科": "本科",
          "学士": "本科",
          "大专": "大专",
          "专科": "大专"
        }
      },
      "required": true
    },
    {
      "name": "毕业年份",
      "type": "int",
      "question": "你是哪一年毕业的？（可直接说\"2026届\"）",
      "extract": {
        "regex_int": {
          "pattern": "(20[0-3]\\d)",
          "min": 2015,
          "max": 2035,
          "near": 2026,
          "recent_any": [
            "应届",
            "今年毕业"
          ],
          "recent_value": 2026
        }
      },
      "required": true
    },
    {
      "name": "状态",
      "type": "enum",
      "options": [
        "就业",
        "创业",
        "灵活就业",
        "待业"
      ],
      "question": "你目前的状态是：就业、创业、灵活就业，还是待业？",
      "extract": {
        "any_of": {
          "灵活就业": "灵活就业",
          "自由职业": "灵活就业",
          "创业": "创业",
          "开公司": "创业",
          "开店": "创业",
          "入职": "就业",
          "上班": "就业",
          "就业": "就业"
        }
      },
      "required": true
    },
    {
      "name": "是否首次创业",
      "type": "bool",
      "question": "你是第一次创业吗？",
      "ask_if": {
        "field": "状态",
        "in": [
          "创业",
          null
        ]
      },
      "extract": {
        "bool": {
          "true_any": [
            "第一次创业",
            "首次创业",
            "第一次开",
            "第一次自己干"
          ],
          "false_any": [
            "不是首次",
            "之前创过",
            "第二次创业",
            "不是第一次"
          ]
        }
      },
      "required": true
    },
    {
      "name": "企业注册地",
      "type": "enum",
      "options": [
        "姑苏区",
        "虎丘区",
        "工业园区",
        "高新区",
        "吴中区",
        "相城区",
        "吴江区",
        "常熟市",
        "张家港市",
        "昆山市",
        "太仓市"
      ],
      "question": "企业注册在苏州哪个区？（如工业园区、姑苏区、昆山等）",
      "ask_if": {
        "all": [
          {
            "field": "状态",
            "in": [
              "创业",
              null
            ]
          },
          {
            "field": "城市",
            "in": [
              "苏州",
              null
            ]
          }
        ]
      },
      "extract": {
        "any_of": {
          "工业园区": "工业园区",
          "园区": "工业园区",
          "姑苏": "姑苏区",
          "虎丘": "虎丘区",
          "高新区": "高新区",
          "吴中": "吴中区",
          "相城": "相城区",
          "吴江": "吴江区",
          "常熟": "常熟市",
          "张家港": "张家港市",
          "昆山": "昆山市",
          "太仓": "太仓市"
        }
      },
      "required": true
    },
    {
      "name": "社保缴纳月数",
      "type": "int",
      "question": "你在苏州已经缴纳了几个月社保？",
      "extract": {
        "regex_int": {
          "pattern": "社保[^0-9]{0,4}(\\d{1,2})\\s*个?月",
          "min": 0,
          "max": 600
        }
      },
      "required": false
    },
    {
      "name": "困难情形",
      "type": "bool",
      "question": "你是否属于城乡低保家庭、残疾人或曾获国家助学贷款等困难情形？",
      "extract": {
        "bool": {
          "true_any": [
            "低保",
            "残疾",
            "助学贷款",
            "困难家庭"
          ],
          "false_any": [
            "不属于",
            "没有上述",
            "都不是"
          ]
        }
      },
      "required": false
    }
  ]
}